generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum MeterType {
  ELECTRICITY
  COLD_WATER
  HOT_WATER
  HEAT
}

enum Unit {
  KWH
  M3
  GJ
}

model Meter {
  id        Int       @id @default(autoincrement())
  type      MeterType
  name      String
  unit      Unit
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  ownerId   Int?
  owner     User?     @relation(fields: [ownerId], references: [id])
  readings  Reading[]
  tariffs   Tariff[]

  @@index([ownerId])
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  passwordHash       String
  isOwner            Boolean   @default(false)
  disabled           Boolean   @default(false)
  mustChangePassword Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  meters             Meter[]
  sessions           Session[]
}

model Session {
  tokenHash  String   @id
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

model Reading {
  id      Int      @id @default(autoincrement())
  meterId Int
  meter   Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  date    DateTime
  value   Decimal
  note    String?

  @@index([meterId, date])
}

model Tariff {
  id         Int      @id @default(autoincrement())
  meterId    Int
  meter      Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  validFrom  DateTime
  unitPrice  Decimal
  monthlyFee Decimal  @default(0)
  note       String?

  @@index([meterId, validFrom])
}
